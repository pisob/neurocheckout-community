# Public OAuth client ID created in NeuroCheckout Cloud > Community installations.
NC_COMMUNITY_CLIENT_ID=nc_replace_with_your_public_client_id

# Exact callback registered in Cloud. HTTP is allowed only on loopback hosts.
NC_COMMUNITY_REDIRECT_URI=http://localhost:3400/api/auth/callback

# Server-to-server Cloud endpoints. These values are never sent to the browser.
NC_CLOUD_API_BASE_URL=http://localhost:8000
NC_CLOUD_AUTHORIZATION_URL=http://localhost:3000/community/authorize
NC_CLOUD_UPGRADE_URL=http://localhost:3000/pricing

# At least 32 random characters in production. Never commit the real value.
NC_COMMUNITY_SESSION_SECRET=replace-with-at-least-32-random-characters

# Set to false only for local HTTP development.
NC_COMMUNITY_COOKIE_SECURE=false
